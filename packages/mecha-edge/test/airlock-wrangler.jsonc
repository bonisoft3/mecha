{
  "name": "mecha-edge-airlock-test",
  "main": "airlock-worker.ts",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLUSTER",
        "class_name": "Cluster"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Cluster"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "JWT_SECRET": "test-secret",
    "IMPORT_TOKEN": "test-import",
    "AIRLOCK_SEAL_PUBLIC": "{\"kid\":\"YFkxR9y1FZl6Huzl\",\"key\":{\"kty\":\"RSA\",\"n\":\"1GNn4UxjZzAAl0l_X13i67ZLmUugv9VQf4XYvziuiaje0j_C1qiqS6Dm4JpePclByBnt7q79aw79h6HGJJnwbpeHgG7g1P_hY1tPS3QIlXY2N7eiq7-5_xrXKHnY__wh7QRnk3g9dPMlhyddcoJSBkQu8u191jbsWhhsAStXcEBPAZ35Pty-rWPTcPDniu0EX4Inzmh1mS9cc9pUcVwQ1-eBbdit1-9YROQ70DZuH4Wd1aW7LbMCU89EIYInKHRDgeyBLxv3b9kx7HdA3n5qwdbqqI3FOqxTknyiRICoJ3whyk5MTDSp65QBWy-0pSjbcCM_QT_UsYdK-xNYPJ1-hDy3YlCjrFZ8VWOsdMdhOB5wesrNFNSQCtW4K-i9Jpo1-IaMOBDS2LhDGIk4JlzN2AmFw1PVTfDnoz7bl4sKXuZlAS_x2BgbscTWAgedF7WYo6kzEM1BNRBiPeBybf0yBBpWhGEoVgnMDVFuGShgc2nGm7mbC1RLwcYj0YLZKTXJ\",\"e\":\"AQAB\",\"alg\":\"RSA-OAEP-256\",\"ext\":true,\"key_ops\":[\"encrypt\"]}}"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    },
    {
      "type": "Data",
      "globs": [
        "**/*.data",
        "**/*.tgz"
      ],
      "fallthrough": false
    }
  ],
  "alias": {
    "typescript": "../src/typescript-absent.js",
    "@electric-sql/pglite": "../../pglite-workerd/dist/index.js",
    "@electric-sql/pglite/basefs": "../../pglite-workerd/dist/fs/base.js",
    "@mecha/postgrest-js": "../../postgrest-js/src/index.ts"
  },
  "queues": {
    "producers": [
      {
        "binding": "AIRLOCK_QUEUE",
        "queue": "mecha-edge-airlock-test"
      }
    ]
  }
}
