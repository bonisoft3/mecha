FROM denoland/deno:debian-2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432 AS ticker-image
WORKDIR /app
COPY services/ticker/deno.json services/ticker/deno.lock services/ticker/due.ts services/ticker/sweep.ts services/ticker/main.ts services/ticker/tick-id.ts services/ticker/crud.ts /app/
COPY --parents services/ticker/deno.json services/ticker/deno.lock services/ticker/due.ts services/ticker/sweep.ts services/ticker/main.ts services/ticker/tick-id.ts services/ticker/crud.ts ./
RUN --mount=type=cache,target=/deno-store,id=libraries_mecha-ticker-image:/deno-store,sharing=locked sh -c 'd="${DENO_DIR:-/root/.cache/deno}"; s=/deno-store; k="$(sha256sum deno.lock */deno.lock */*/deno.lock deno.json */deno.json */*/deno.json package.json */package.json 2>/dev/null | sha256sum | cut -d'\'' '\'' -f1)"; mkdir -p "$d" "$s"; for sub in remote npm jsr; do if [ -d "$s/$k/$sub" ]; then mkdir -p "$d/$sub" && cp -a "$s/$k/$sub"/. "$d/$sub"/ 2>/dev/null || true; fi; done; (deno cache main.ts) || exit; t="$s/.tmp.$$"; rm -rf "$t"; mkdir -p "$t"; for sub in remote npm jsr; do if [ -d "$d/$sub" ]; then mkdir -p "$t/$sub" && cp -a "$d/$sub"/. "$t/$sub"/ 2>/dev/null || true; fi; done; rm -rf "$s/$k" && mv "$t" "$s/$k" 2>/dev/null || rm -rf "$t"; find "$s" -mindepth 1 -maxdepth 1 ! -name "$k" -exec rm -rf {} + 2>/dev/null || true'
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.ticker-image.json ./.bayt/
CMD ["run", "--allow-net", "--allow-env", "main.ts"]

