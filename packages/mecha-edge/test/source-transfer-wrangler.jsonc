{
  "name": "source-chunk-local-proof",
  "main": "source-transfer-worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SOURCE",
        "class_name": "Source"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Source"
      ]
    }
  ],
  "assets": {
    "directory": "../../duckdb-workerd/.build/duckdb/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ]
}
