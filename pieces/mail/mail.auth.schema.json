{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "props"
  ],
  "properties": {
    "type": {
      "const": "CUSTOM_AUTH"
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "password"
      ],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "\\S"
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
