diff --git a/src/backend/utils/misc/timeout.c b/src/backend/utils/misc/timeout.c
index d92efa1255..d554227579 100644
--- a/src/backend/utils/misc/timeout.c
+++ b/src/backend/utils/misc/timeout.c
@@ -828,3 +828,25 @@ get_timeout_finish_time(TimeoutId id)
 {
 	return all_timeouts[id].fin_time;
 }
+
+#ifdef __PGLITE__
+/*
+ * disable_alarm() leaves the interval timer armed, to save setitimer() calls,
+ * and the stale interrupt is ignored when it fires. PGlite returns to its host
+ * after every message, and a host that hibernates idle code (a Durable Object)
+ * stays awake while a timer is pending, so with no timeout active the timer
+ * is cancelled.
+ */
+void
+pgl_cancel_idle_alarm(void)
+{
+	struct itimerval timeval;
+
+	if (num_active_timeouts > 0 || !signal_pending)
+		return;
+	MemSet(&timeval, 0, sizeof(struct itimerval));
+	if (setitimer(ITIMER_REAL, &timeval, NULL) != 0)
+		elog(FATAL, "could not disable SIGALRM timer: %m");
+	signal_pending = false;
+}
+#endif
