@@ -0,0 +1,22 @@
+/*
+ * Modules linked into the backend instead of loaded as side modules; see
+ * pgl_dlopen() in pglitec.c. A build that links any defines
+ * pgl_static_modules, ending in an entry with a NULL name, each module's
+ * symbols ending likewise.
+ */
+#ifndef PGL_STATIC_MODULES_H
+#define PGL_STATIC_MODULES_H
+
+typedef struct pgl_static_symbol {
+    const char *name;
+    void *address;
+} pgl_static_symbol;
+
+typedef struct pgl_static_module {
+    const char *name;
+    const pgl_static_symbol *symbols;
+} pgl_static_module;
+
+extern const pgl_static_module pgl_static_modules[] __attribute__((weak));
+
+#endif
