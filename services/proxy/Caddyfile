{
	admin off
}

:8080 {
	handle /crud/* {
		uri strip_prefix /crud
		# Idempotent inserts by default — duplicate POSTs with the same
		# primary key are silently absorbed by PostgREST instead of returning
		# 409 Conflict. This makes at-least-once delivery safe at the CRUD
		# boundary.
		@post method POST
		request_header @post Prefer "return=representation,resolution=ignore-duplicates"
		reverse_proxy crud:3000
	}

	# Electric's `table` and `where` are the authorization, so a request reaches
	# it only through the gatekeeper, which compares both against the shape
	# token. `route` keeps the order as written: outside one, Caddy sorts `uri`
	# ahead of `forward_auth`, and the gate would refuse the secret the proxy
	# itself had just added.
	handle /electric/* {
		uri strip_prefix /electric
		route {
			forward_auth auth:9999 {
				uri /auth/shape/verify
			}
			uri query secret {$ELECTRIC_SECRET}
			reverse_proxy electric:3000 {
				flush_interval -1
				transport http {
					read_timeout 300s
				}
			}
		}
	}

	# Mounted WITH the prefix: the auth service's routes carry /auth.
	handle /auth/* {
		reverse_proxy auth:9999
	}

	handle /img/* {
		uri strip_prefix /img
		reverse_proxy imgproxy:8081 {
			flush_interval -1
		}
	}

	# Mounted WITH the prefix: the ticker answers POST /poke and 404s
	# everything else, so stripping would 404 every poke.
	handle /poke {
		reverse_proxy ticker:9998
	}

	handle /health {
		respond "OK" 200
	}

	handle {
		respond "Not Found" 404
	}
}
