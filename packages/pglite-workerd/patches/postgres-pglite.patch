+}
+/* ========== Statically linked modules ==========
+*
+* A build may link modules (plpgsql, dict_snowball) into the backend instead of
+* loading them as side modules, for hosts that cannot compile wasm at runtime.
+* dlopen() of a file whose basename (without .so) names one of them returns
+* its entry in pgl_static_modules, and dlsym() on that handle looks the symbol
+* up in the entry. Every other file goes to the dynamic linker.
+*/
+
+static const pgl_static_module *
+pgl_static_module_of(const void *handle) {
+    if (!pgl_static_modules)
+        return NULL;
+    for (const pgl_static_module *m = pgl_static_modules; m->name; m++)
+        if (m == handle)
+            return m;
+    return NULL;
+}
+
+void* EMSCRIPTEN_KEEPALIVE
+pgl_dlopen(const char *file, int mode) {
+    if (file && pgl_static_modules) {
+        const char *base = strrchr(file, '/');
+        size_t len;
+        base = base ? base + 1 : file;
+        len = strlen(base);
+        if (len > 3 && strcmp(base + len - 3, ".so") == 0)
+            len -= 3;
+        for (const pgl_static_module *m = pgl_static_modules; m->name; m++)
+            if (strlen(m->name) == len && strncmp(m->name, base, len) == 0)
+                return (void *) m;
+    }
+    return dlopen(file, mode);
+}
+
+void* EMSCRIPTEN_KEEPALIVE
+pgl_dlsym(void *handle, const char *name) {
+    const pgl_static_module *m = pgl_static_module_of(handle);
+    if (!m)
+        return dlsym(handle, name);
+    for (const pgl_static_symbol *s = m->symbols; s->name; s++)
+        if (strcmp(s->name, name) == 0)
+            return s->address;
+    return NULL;
+}
+
+int EMSCRIPTEN_KEEPALIVE
+pgl_dlclose(void *handle) {
+    if (pgl_static_module_of(handle))
+        return 0;
+    return dlclose(handle);
+}
