{
  "name": "mecha-edge-blobs-test",
  "main": "blobs-worker.ts",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CLUSTER", "class_name": "Cluster" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cluster"] }],
  "r2_buckets": [{ "binding": "BLOB_OBJECTS", "bucket_name": "mecha-edge-blobs-test" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "HATCH_SETTING": "fixture-config", "JWT_SECRET": "test-secret", "IMPORT_TOKEN": "test-import" },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Data", "globs": ["**/*.data", "**/*.tgz"], "fallthrough": false }
  ],
  "alias": {
    "typescript": "../src/typescript-absent.js",
    "@electric-sql/pglite": "../../pglite-workerd/dist/index.js",
    "@electric-sql/pglite/basefs": "../../pglite-workerd/dist/fs/base.js",
    "@mecha/postgrest-js": "../../postgrest-js/src/index.ts"
  }
}
