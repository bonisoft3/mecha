# generated from bayt.cue — do not edit
FROM redis:8.2.11-bookworm@sha256:b0b01167ff47bc3868e56a967895a26be4230891a1f42a78ab61cdd227accc8d AS redis
WORKDIR /data
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.redis.json ./.bayt/
EXPOSE 6379
HEALTHCHECK --interval=5s --timeout=3s --retries=6 --start-period=10s CMD redis-cli ping | grep PONG

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS redis_bayt_ctxs
WORKDIR /monorepo/libraries/mecha
COPY --parents .bayt/compose.redis.yaml .bayt/Dockerfile.redis .bayt/bayt.redis.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then mkdir -p /.bayt-clamp && find /monorepo/libraries/mecha -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a /monorepo/libraries/mecha /.bayt-clamp/w && rm -rf /monorepo/libraries/mecha && mv /.bayt-clamp/w /monorepo/libraries/mecha; fi && rm -rf /.bayt-clamp && find /monorepo/libraries/mecha -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo /monorepo/libraries; fi
FROM scratch AS redis_bayt
COPY --from=redis_bayt_ctxs /monorepo /monorepo
